# Copy to .env.local (never commit it). Used only by `npm run db:seed` to create the two accounts;
# passwords are stored as scrypt hashes in the database, never in client code.
SEED_PASSWORD_ADITYA=
SEED_PASSWORD_HARSH=

# Optional
# DATABASE_PATH=./data/groundwork.db
# UPLOAD_DIR=./data/uploads
# SYLLABUS_DIR=./syllabus
